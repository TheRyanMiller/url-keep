{
  "name": "url-keep",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @url-keep/api",
    "dev:web": "npm run dev --workspace @url-keep/web",
    "dev:api": "npm run dev --workspace @url-keep/api",
    "d1:migrate:local": "npx wrangler d1 migrations apply DB --local --config apps/api/wrangler.toml",
    "d1:migrate:remote": "npx wrangler d1 migrations apply DB --remote --config apps/api/wrangler.toml",
    "deploy:api": "npx wrangler deploy --config apps/api/wrangler.toml",
    "bootstrap:admin": "tsx ./apps/api/scripts/bootstrap-admin.ts",
    "backfill:bookmark-buckets": "tsx ./apps/api/scripts/backfill-bookmark-buckets.ts",
    "build:web": "npm run build --workspace @url-keep/web",
    "build:extension": "npm run build --workspace @url-keep/extension",
    "typecheck:api": "npm run typecheck --workspace @url-keep/api"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
